@article{shi2025customer,
  selected={true},
  title = {You Are What You Bought: Generating Customer Personas for E-commerce Applications},
  author = {Yimin Shi and Yang Fei and Shiqi Zhang and Haixun Wang and Xiaokui Xiao},
  year = {2025},
  month = aug,
  journal = {ACM SIGIR},
  note = {Accepted},
  abstract = {Customer personas are abstract archetypes representing distinct customer segments in e-commerce. This paper proposes an innovative approach to generate these personas automatically using Large Language Models (LLMs) based on customer purchase behavior. By analyzing transaction histories and product interactions, we construct a tripartite graph connecting customers, products, and generated personas. We then integrate these personas with graph neural networks to improve recommendation performance. Our experimental results demonstrate a 5-15% improvement in major accuracy metrics across multiple e-commerce datasets.},
  keywords={E-commerce, Customer Personas, LLM, Recommender Systems}
}

@article{huang2024thriftllm,
  title = {ThriftLLM: On Cost-Effective Selection of Large Language Models for Optimal Query Performance},
  author = {Keke Huang and Yimin Shi and Dujian Ding and Yifei Li and Yang Fei and Laks Lakshmanan and Xiaokui Xiao},
  year = {2024},
  month = oct,
  note = {Preprint},
  url = {https://arxiv.org/abs/2501.04901},
  abstract = {With the proliferation of Large Language Models (LLMs), organizations face the challenge of selecting the most cost-effective models for their specific use cases. This paper proposes ThriftLLM, a framework for analyzing and selecting LLMs based on performance-to-cost ratios. We evaluate multiple LLM candidates on various query types and derive optimal selection strategies that maximize performance while minimizing computational costs.},
  keywords={Large Language Models, Cost-effectiveness, Model Selection, Query Performance}
}

